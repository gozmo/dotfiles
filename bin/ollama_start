#!/usr/bin/env bash
set -e

# ⚙️ CONFIGURATION
MODEL="qwen3.6:27b"  # 🔍 Replace with your exact Ollama tag (run `ollama list` to verify)
MAX_PARALLEL=4       # Adjust based on VRAM/RAM (see tuning guide below)

echo "🔧 Preparing Ollama for multi-session concurrency..."

# 📥 Pull model if not present
if ! ollama list | grep -q "^${MODEL}"; then
    echo "📦 Pulling $MODEL (this may take several minutes)..."
    ollama pull "$MODEL"
else
    echo "✅ Model $MODEL already cached."
fi

# 🔄 Stop existing Ollama process to apply new environment variables
if pgrep -x "ollama" > /dev/null; then
    echo "🔁 Restarting Ollama to apply configuration..."
    killall ollama 2>/dev/null || pkill ollama 2>/dev/null
    sleep 3
fi

# 🚀 Start Ollama with multi-session optimized environment variables
echo "🔥 Starting Ollama server..."
# Inline env vars prevent global leakage and ensure clean restarts
OLLAMA_NUM_PARALLEL="$MAX_PARALLEL" \
OLLAMA_KEEP_ALIVE="-1" \
OLLAMA_HOST="0.0.0.0:11434" \
OLLAMA_ORIGINS="*" \
ollama serve

echo "✅ Ollama is running. Press Ctrl+C to stop."
