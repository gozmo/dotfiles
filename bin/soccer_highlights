#!/usr/bin/env python3
from __future__ import annotations

import json
import re
import urllib.request
from dataclasses import dataclass
from datetime import timedelta

USER_AGENT = "Mozilla/5.0 (X11; Linux x86_64)"
HIGHLIGHT_LIMIT = 5
RECENT_DAYS = 7
BROWSE_URL = "https://www.youtube.com/youtubei/v1/browse"
YOUTUBE_KEY = "AIzaSyAO_FJ2SlqU8Q4STEHLGCilw_Y9_11qcW8"
RE_INITIAL_DATA = re.compile(r"var ytInitialData = (\{.*?\});</script>", re.DOTALL)
AGE_UNITS = {
    "minute": timedelta(minutes=1),
    "hour": timedelta(hours=1),
    "day": timedelta(days=1),
    "week": timedelta(weeks=1),
    "month": timedelta(days=30),
    "year": timedelta(days=365),
}


@dataclass
class HighlightTeam:
    name: str
    keywords: tuple[str, ...]
    color: str


@dataclass
class Channel:
    name: str
    handle: str
    color: str
    teams: list[HighlightTeam]


@dataclass
class Video:
    title: str
    published: str
    url: str
    age: timedelta


class TermColor:
     BLACK = '\033[30m'
     RED = '\033[31m'
     GREEN = '\033[32m'
     YELLOW = '\033[33m' # orange on some systems
     BLUE = '\033[34m'
     MAGENTA = '\033[35m'
     CYAN = '\033[36m'
     LIGHT_GRAY = '\033[37m'
     DARK_GRAY = '\033[90m'
     BRIGHT_RED = '\033[91m'
     BRIGHT_GREEN = '\033[92m'
     BRIGHT_YELLOW = '\033[93m'
     BRIGHT_BLUE = '\033[94m'
     BRIGHT_MAGENTA = '\033[95m'
     BRIGHT_CYAN = '\033[96m'
     WHITE = '\033[97m'

     RESET = '\033[0m'


CHANNELS = [
    Channel(
        name="EFL",
        handle="https://www.youtube.com/@theEFL/videos",
        color=TermColor.BRIGHT_CYAN,
        teams=[
            HighlightTeam("Blackburn Rovers", ("blackburn",), TermColor.CYAN),
            HighlightTeam("West Ham United", ("west ham",), TermColor.LIGHT_GRAY),
            HighlightTeam("Luton Town", ("luton",), TermColor.YELLOW),
        ],
    ),
    Channel(
        name="Serie A",
        handle="https://www.youtube.com/@seriea/videos",
        color=TermColor.BLUE,
        teams=[
            HighlightTeam("Atalanta", ("atalanta",), TermColor.BLUE),
        ],
    ),
    Channel(
        name="Bundesliga",
        handle="https://www.youtube.com/@bundesliga/videos",
        color=TermColor.BRIGHT_YELLOW,
        teams=[
            HighlightTeam("Union Berlin", ("union berlin",), TermColor.BRIGHT_RED),
        ],
    ),
]


def fetch_text(url: str, body: dict | None = None) -> str:
    payload = json.dumps(body).encode() if body else None
    headers = {"User-Agent": USER_AGENT}
    if body:
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(url, data=payload, headers=headers)
    with urllib.request.urlopen(request, timeout=20) as response:
        return response.read().decode("utf-8", errors="replace")


def parse_age(relative: str) -> timedelta:
    text = re.sub(r"^(Streamed|Premiered) ", "", relative)
    match = re.search(r"(\d+)\s+(\w+)\s+ago", text)
    if not match:
        return timedelta.max
    unit = AGE_UNITS.get(match.group(2).rstrip("s"))
    if unit is None:
        return timedelta.max
    return int(match.group(1)) * unit


def parse_video(content: dict) -> Video | None:
    view = content.get("lockupViewModel")
    if view:
        metadata = view["metadata"]["lockupMetadataViewModel"]
        title = metadata["title"]["content"]
        video_id = view["contentId"]
        rows = metadata["metadata"]["contentMetadataViewModel"]["metadataRows"]
        relative = rows[0]["metadataParts"][-1]["text"]["content"]
        return Video(
            title=title,
            published=relative,
            url=f"https://www.youtube.com/watch?v={video_id}",
            age=parse_age(relative),
        )
    renderer = content.get("videoRenderer")
    if renderer:
        title = renderer["title"]["runs"][0]["text"]
        relative = renderer["publishedTimeText"]["simpleText"]
        return Video(
            title=title,
            published=relative,
            url=f"https://www.youtube.com/watch?v={renderer['videoId']}",
            age=parse_age(relative),
        )
    return None


def parse_items(items: list[dict]) -> tuple[list[Video], str | None]:
    videos = []
    token = None
    for item in items:
        if "richItemRenderer" in item:
            video = parse_video(item["richItemRenderer"]["content"])
            if video:
                videos.append(video)
        elif "continuationItemRenderer" in item:
            token = item["continuationItemRenderer"]["continuationEndpoint"][
                "continuationCommand"
            ]["token"]
    return videos, token


def grid_items(html: str) -> tuple[list[Video], str | None]:
    match = RE_INITIAL_DATA.search(html)
    if not match:
        raise RuntimeError("could not parse channel videos page")
    data = json.loads(match.group(1))
    tabs = data["contents"]["twoColumnBrowseResultsRenderer"]["tabs"]
    for tab in tabs:
        renderer = tab.get("tabRenderer", {})
        if renderer.get("selected"):
            items = renderer["content"]["richGridRenderer"]["contents"]
            return parse_items(items)
    return [], None


def fetch_continuation(token: str) -> tuple[list[Video], str | None]:
    body = {
        "context": {
            "client": {
                "clientName": "WEB",
                "clientVersion": "2.20240101.00.00",
                "hl": "en",
                "gl": "US",
            }
        },
        "continuation": token,
    }
    data = json.loads(fetch_text(f"{BROWSE_URL}?key={YOUTUBE_KEY}", body))
    items = data["onResponseReceivedActions"][0]["appendContinuationItemsAction"][
        "continuationItems"
    ]
    return parse_items(items)


def collect_videos(channel: Channel) -> list[Video]:
    cutoff = timedelta(days=RECENT_DAYS)
    videos, token = grid_items(fetch_text(channel.handle + "?hl=en&gl=US"))
    collected = list(videos)
    while token and any(video.age <= cutoff for video in videos):
        videos, token = fetch_continuation(token)
        collected.extend(videos)
    return collected


def team_videos(videos: list[Video], team: HighlightTeam) -> list[Video]:
    cutoff = timedelta(days=RECENT_DAYS)
    selected = [
        video
        for video in videos
        if video.age <= cutoff
        and any(keyword in video.title.lower() for keyword in team.keywords)
    ]
    return selected[:HIGHLIGHT_LIMIT]


def format_videos(team: HighlightTeam, videos: list[Video]) -> str:
    name = team.color + team.name + TermColor.RESET
    lines = [name]
    if not videos:
        lines.append("  no recent highlights found")
        return "\n".join(lines)
    for video in videos:
        lines.append(f"  {video.published} · {video.title}")
        lines.append(f"          {video.url}")
    return "\n".join(lines)


def format_channel(channel: Channel, teams_output: list[str]) -> str:
    header = channel.color + channel.name + TermColor.RESET
    return header + "\n" + "\n\n".join(teams_output)


def main() -> None:
    for channel in CHANNELS:
        videos = collect_videos(channel)
        teams_output = [
            format_videos(team, team_videos(videos, team)) for team in channel.teams
        ]
        print(format_channel(channel, teams_output))
        print()


if __name__ == "__main__":
    main()
