#!/usr/bin/env python3
from __future__ import annotations

import re
import urllib.request
import xml.etree.ElementTree as ET
from dataclasses import dataclass

RSS_FEED = "https://www.youtube.com/feeds/videos.xml?channel_id="
USER_AGENT = "Mozilla/5.0 (X11; Linux x86_64)"
HIGHLIGHT_LIMIT = 5


@dataclass
class HighlightTeam:
    name: str
    keywords: tuple[str, ...]
    color: str


@dataclass
class Channel:
    name: str
    handle: str
    color: str
    teams: list[HighlightTeam]


@dataclass
class Video:
    title: str
    published: str
    url: str


class TermColor:
     BLACK = '\033[30m'
     RED = '\033[31m'
     GREEN = '\033[32m'
     YELLOW = '\033[33m' # orange on some systems
     BLUE = '\033[34m'
     MAGENTA = '\033[35m'
     CYAN = '\033[36m'
     LIGHT_GRAY = '\033[37m'
     DARK_GRAY = '\033[90m'
     BRIGHT_RED = '\033[91m'
     BRIGHT_GREEN = '\033[92m'
     BRIGHT_YELLOW = '\033[93m'
     BRIGHT_BLUE = '\033[94m'
     BRIGHT_MAGENTA = '\033[95m'
     BRIGHT_CYAN = '\033[96m'
     WHITE = '\033[97m'

     RESET = '\033[0m'


CHANNELS = [
    Channel(
        name="EFL",
        handle="https://www.youtube.com/@theEFL/videos",
        color=TermColor.BRIGHT_CYAN,
        teams=[
            HighlightTeam("Blackburn Rovers", ("blackburn",), TermColor.CYAN),
            HighlightTeam("West Ham United", ("west ham",), TermColor.LIGHT_GRAY),
        ],
    ),
    Channel(
        name="Serie A",
        handle="https://www.youtube.com/@seriea/videos",
        color=TermColor.BLUE,
        teams=[
            HighlightTeam("Atalanta", ("atalanta",), TermColor.BLUE),
        ],
    ),
    Channel(
        name="Bundesliga",
        handle="https://www.youtube.com/@bundesliga/videos",
        color=TermColor.BRIGHT_YELLOW,
        teams=[
            HighlightTeam("Union Berlin", ("union berlin",), TermColor.BRIGHT_RED),
        ],
    ),
]


def fetch_text(url: str) -> str:
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(request, timeout=20) as response:
        return response.read().decode("utf-8", errors="replace")


def resolve_channel_id(channel: Channel) -> str:
    html = fetch_text(channel.handle)
    match = re.search(r'"externalId":"(UC[\w-]+)"', html)
    if not match:
        raise RuntimeError(f"could not find channel id for {channel.name}")
    return match.group(1)


def parse_videos(xml_text: str) -> list[Video]:
    feed = ET.fromstring(xml_text)
    videos = []
    for entry in feed.findall("{http://www.w3.org/2005/Atom}entry"):
        title = entry.find("{http://www.w3.org/2005/Atom}title").text
        published = entry.find("{http://www.w3.org/2005/Atom}published").text
        url = ""
        for link in entry.findall("{http://www.w3.org/2005/Atom}link"):
            if link.get("rel") == "alternate":
                url = link.get("href")
        videos.append(Video(title=title, published=published, url=url))
    return videos


def team_videos(videos: list[Video], team: HighlightTeam) -> list[Video]:
    selected = [
        video
        for video in videos
        if any(keyword in video.title.lower() for keyword in team.keywords)
    ]
    return selected[:HIGHLIGHT_LIMIT]


def format_videos(team: HighlightTeam, videos: list[Video]) -> str:
    name = team.color + team.name + TermColor.RESET
    lines = [name]
    if not videos:
        lines.append("  no recent highlights found")
        return "\n".join(lines)
    for video in videos:
        date = video.published[:10]
        lines.append(f"  {date} · {video.title}")
        lines.append(f"          {video.url}")
    return "\n".join(lines)


def format_channel(channel: Channel, teams_output: list[str]) -> str:
    header = channel.color + channel.name + TermColor.RESET
    return header + "\n" + "\n\n".join(teams_output)


def main() -> None:
    for channel in CHANNELS:
        channel_id = resolve_channel_id(channel)
        videos = parse_videos(fetch_text(RSS_FEED + channel_id))
        teams_output = [
            format_videos(team, team_videos(videos, team)) for team in channel.teams
        ]
        print(format_channel(channel, teams_output))
        print()


if __name__ == "__main__":
    main()
