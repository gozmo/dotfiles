#!/usr/bin/env python3
"""Generates an ASCII-art hostname banner with dynamic per-machine gradients.

Options:
  -r, --random    Use a random theme instead of the machine's stable identity.
"""

import sys
import socket
import zlib
import random

FONT = {
    'a': [" █████╗ ", "██╔══██╗", "███████║", "██╔══██║", "██║  ██║", "╚═╝  ╚═╝"],
    'b': ["██████╗ ", "██╔══██╗", "██████╔╝", "██╔══██╗", "██████╔╝", "╚═════╝ "],
    'c': [" ██████╗", "██╔════╝", "██║     ", "██║     ", "╚██████╗", " ╚═════╝"],
    'd': ["██████╗ ", "██╔══██╗", "██║  ██║", "██║  ██║", "██████╔╝", "╚═════╝ "],
    'e': ["███████╗", "██╔════╝", "█████╗  ", "██╔══╝  ", "███████╗", "╚══════╝"],
    'f': ["███████╗", "██╔════╝", "█████╗  ", "██╔══╝  ", "██║     ", "╚═╝     "],
    'g': [" ██████╗ ", "██╔════╝ ", "██║  ███╗", "██║   ██║", "╚██████╔╝", " ╚═════╝ "],
    'h': ["██╗  ██╗", "██║  ██║", "███████║", "██╔══██║", "██║  ██║", "╚═╝  ╚═╝"],
    'i': ["██╗", "██║", "██║", "██║", "██║", "╚═╝"],
    'j': ["     ██╗", "     ██║", "     ██║", "██   ██║", "╚█████╔╝", " ╚════╝ "],
    'k': ["██╗  ██╗", "██║ ██╔╝", "█████╔╝ ", "██╔═██╗ ", "██║  ██╗", "╚═╝  ╚═╝"],
    'l': ["██╗     ", "██║     ", "██║     ", "██║     ", "███████╗", "╚══════╝"],
    'm': ["███╗   ███╗", "████╗ ████║", "██╔████╔██║", "██║╚██╔╝██║", "██║ ╚═╝ ██║", "╚═╝     ╚═╝"],
    'n': ["███╗   ██╗", "████╗  ██║", "██╔██╗ ██║", "██║╚██╗██║", "██║ ╚████║", "╚═╝  ╚═══╝"],
    'o': [" ██████╗ ", "██╔═══██╗", "██║   ██║", "██║   ██║", "╚██████╔╝", " ╚═════╝ "],
    'p': ["██████╗ ", "██╔══██╗", "██████╔╝", "██╔═══╝ ", "██║     ", "╚═╝     "],
    'q': [" ██████╗ ", "██╔═══██╗", "██║   ██║", "██║▄▄ ██║", "╚██████╔╝", " ╚══▀▀═╝ "],
    'r': ["██████╗ ", "██╔══██╗", "██████╔╝", "██╔══██╗", "██║  ██║", "╚═╝  ╚═╝"],
    's': ["███████╗", "██╔════╝", "███████╗", "╚════██║", "███████║", "╚══════╝"],
    't': ["████████╗", "╚══██╔══╝", "   ██║   ", "   ██║   ", "   ██║   ", "   ╚═╝   "],
    'u': ["██╗   ██╗", "██║   ██║", "██║   ██║", "██║   ██║", "╚██████╔╝", " ╚═════╝ "],
    'v': ["██╗   ██╗", "██║   ██║", "██║   ██║", "╚██╗ ██╔╝", " ╚████╔╝ ", "  ╚═══╝  "],
    'w': ["██╗    ██╗", "██║    ██║", "██║ █╗ ██║", "██║███╗██║", "╚███╔███╔╝", "╚══╝╚══╝ "],
    'x': ["██╗  ██╗", "╚██╗██╔╝", " ╚███╔╝ ", " ██╔██╗ ", "██╔╝ ██║", "╚═╝  ╚═╝"],
    'y': ["██╗   ██╗", "╚██╗ ██╔╝", " ╚████╔╝ ", "  ╚██╔╝  ", "   ██║   ", "   ╚═╝   "],
    'z': ["███████╗", "╚══███╔╝", "  ███╔╝ ", " ███╔╝  ", "███████╗", "╚══════╝"],
}

# Gradient Palettes: Start Color -> End Color (TrueColor RGB)
PALETTES = {
    "sunset":  {"start": (255, 105, 180), "end": (255, 61, 0)},   # Hot Pink -> Deep Orange
    "ocean":   {"start": (39, 49, 79),   "end": (135, 218, 255)}, # Dark Blue -> Azure
    "neon":    {"start": (200, 0, 255),   "end": (0, 255, 127)}, # Electric Purple -> Spring Green
    "inferno": {"start": (139, 0, 0),     "end": (255, 215, 0)}, # Crimson Fire -> Gold
}

FONT_ROWS = len(next(iter(FONT.values())))
PAD = "      "

def pick_theme(hostname: str, use_random: bool) -> tuple[tuple[int,int,int], tuple[int,int,int]]:
    """Select a gradient theme based on hostname hash or random luck."""
    palette_names = list(PALETTES.keys())
    
    if use_random:
        selected_name = random.choice(palette_names)
    else:
        # Deterministic Stable Randomness using CRC32
        idx = zlib.crc32(hostname.encode()) % len(palette_names)
        selected_name = palette_names[idx]

    theme = PALETTES[selected_name]
    return (theme["start"][0], theme["start"][1], theme["start"][2]), \
           (theme["end"][0],   theme["end"][1],   theme["end"][2])

def interpolate_color(start_rgb, end_rgb, ratio: float) -> tuple[int,int,int]:
    """Linear RGB interpolation based on position along the text."""
    return tuple(int(s + (e - s) * ratio) for s, e in zip(start_rgb, end_rgb))

def main():
    # Parse simple arguments manually to keep it dependency-light or use argparse
    use_random = "-r" in sys.argv or "--random" in sys.argv
    
    hostname = socket.gethostname().lower()
    
    # Filter only characters present in the font (skip numbers/symbols as agreed)
    visible_chars = [c for c in hostname if c in FONT]
    
    if not visible_chars:
        return

    count = len(visible_chars)
    start_rgb, end_rgb = pick_theme(hostname, use_random)

    # Precompute colors for each letter position (0.0 to 1.0 spread)
    precomputed_colors = []
    divisor = max(count - 1, 1)
    
    for i in range(count):
        ratio = i / divisor
        rgb = interpolate_color(start_rgb, end_rgb, ratio)
        # TrueColor ANSI: \033[38;2;R;G;Bm
        precomputed_colors.append(f"\033[38;2;{rgb[0]};{rgb[1]};{rgb[2]}m")

    # Render row by row to keep the block art alignment tight
    for row_idx in range(FONT_ROWS):
        line_data = []
        for i, char in enumerate(visible_chars):
            color_code = precomputed_colors[i]
            glyph_row = FONT[char][row_idx]
            line_data.append(f"{color_code}{glyph_row}{PAD}")
        
        print("".join(line_data))

if __name__ == "__main__":
    main()
