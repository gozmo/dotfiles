# Define Palettes using an array of RGB tuples (stops).
PALETTES = [
    # --- 2-Stop Gradients ---
    {
        "name": "sunset",
        "colors": [(255, 105, 180), (255, 61, 0)]       # Hot Pink -> Deep Orange
    },
    {
        "name": "ocean",
        "colors": [(39, 49, 79), (135, 218, 255)]       # Dark Blue Sky -> Azure
    },
    {
        "name": "neon",
        "colors": [(200, 0, 255), (0, 255, 127)]        # Electric Purple -> Spring Green
    },
    {
        "name": "inferno",
        "colors": [(139, 0, 0), (255, 215, 0)]          # Crimson Fire -> Gold
    },

    # --- 3-Stop Gradients ---
    {
        "name": "vaporwave",
        "colors": [
            (255, 0, 128),   # Hot Pink Start
            (0, 255, 255),   # Cyan Middle
            (255, 255, 0)    # Yellow End
        ]
    },
    {
        "name": "aurora",
        "colors": [
            (0, 255, 148),   # Spring Green Start
            (60, 10, 255),   # Deep Indigo Middle
            (255, 0, 192)    # Magenta End
        ]
    },
    {
        "name": "galaxy",
        "colors": [
            (75, 0, 130),    # Indigo Start
            (230, 0, 255),   # Bright Violet Middle
            (255, 215, 0)    # Gold End
        ]
    },

    # --- Latest Requests: Specific RGB Transitions ---
    {
        "name": "nature_flow",
        "colors": [
            (0, 0, 255),     # Blue Start
            (0, 255, 0),     # Green Middle
            (255, 255, 0)    # Yellow End
        ]
    },
    {
        "name": "cotton_candy",
        "colors": [
            (255, 105, 180), # Pink Start
            (255, 255, 0),   # Yellow Middle
            (138, 43, 226)   # Purple End
        ]
    },
]

FONT_ROWS = len(next(iter(FONT.values())))
PAD = "      "

def get_palette(hostname: str, use_random: bool) -> list[tuple[int,int,int]]:
    """Deterministically assign a palette or pick randomly."""
    
    if use_random:
        return random.choice(PALETTES)["colors"]
    
    # Deterministic Stable Randomness using CRC32
    idx = zlib.crc32(hostname.encode()) % len(PALETTES)
    return PALETTES[idx]["colors"]

def interpolate_gradient(colors: list[tuple], ratio: float) -> tuple[int,int,int]:
    """Interpolate color based on a normalized ratio 0.0 -> 1.0 through multiple stops."""
    
    num_segments = len(colors) - 1
    
    if ratio <= 0.0:
        return colors[0]
    if ratio >= 1.0:
        return colors[-1]

    # Find the exact segment index (e.g., 2 segments -> seg_idx could be 0.45 or 1.9)
    segment_pos = ratio * num_segments
    seg_idx = int(segment_pos)
    
    # Guard against floating point precision errors
    if seg_idx >= num_segments:
        return colors[-1]

    start_c = colors[seg_idx]
    end_c   = colors[seg_idx + 1]
    
    # Local ratio within this specific segment (0.0 -> 1.0)
    local_ratio = segment_pos - seg_idx
    
    return tuple(int(s + (e - s) * local_ratio) for s, e in zip(start_c, end_c))

def main():
    use_random = "-r" in sys.argv or "--random" in sys.argv
    
    hostname = socket.gethostname().lower()
    
    # Filter only characters present in the font 
    visible_chars = [c for c in hostname if c in FONT]
    
    if not visible_chars:
        return

    count = len(visible_chars)
    colors_stops = get_palette(hostname, use_random)

    # Precompute TrueColor codes for every letter
    precomputed_colors = []
    divisor = max(count - 1, 1)
    
    for i in range(count):
        ratio = i / divisor
        rgb = interpolate_gradient(colors_stops, ratio)
        # \033[38;2;R;G;Bm
        precomputed_colors.append(f"\033[38;2;{rgb[0]};{rgb[1]};{rgb[2]}m")

    # Render row by row to keep alignment tight
    for row_idx in range(FONT_ROWS):
        line_data = []
        for i, char in enumerate(visible_chars):
            color_code = precomputed_colors[i]
            glyph_row = FONT[char][row_idx]
            line_data.append(f"{color_code}{glyph_row}{PAD}")
        
        print("".join(line_data))

if __name__ == "__main__":
    main()
