#!/usr/bin/env python3
"""Generates an ASCII-art hostname banner with per-letter sunset gradients."""

import platform

FONT_ROWS = 6

# ═══════════════════════════════════════════════════════════════════
#  EMBEDDED FONT DATA — 6-row box-drawing characters (a–z)
# ═══════════════════════════════════════════════════════════════════

FONT = {
    'a': [" █████╗ ", "██╔══██╗", "███████║", "██╔══██║", "██║  ██║", "╚═╝  ╚═╝"],
    'b': ["██████╗ ", "██╔══██╗", "██████╔╝", "██╔══██╗", "██████╔╝", "╚═════╝ "],
    'c': [" ██████╗", "██╔════╝", "██║     ", "██║     ", "╚██████╗", " ╚═════╝"],
    'd': ["██████╗ ", "██╔══██╗", "██║  ██║", "██║  ██║", "██████╔╝", "╚═════╝ "],
    'e': ["███████╗", "██╔════╝", "█████╗  ", "██╔══╝  ", "███████╗", "╚══════╝"],
    'f': ["███████╗", "██╔════╝", "█████╗  ", "██╔══╝  ", "██║     ", "╚═╝     "],
    'g': [" ██████╗ ", "██╔════╝ ", "██║  ███╗", "██║   ██║", "╚██████╔╝", " ╚═════╝ "],
    'h': ["██╗  ██╗", "██║  ██║", "███████║", "██╔══██║", "██║  ██║", "╚═╝  ╚═╝"],
    'i': ["██╗", "██║", "██║", "██║", "██║", "╚═╝"],
    'j': ["     ██╗", "     ██║", "     ██║", "██   ██║", "╚█████╔╝", " ╚════╝ "],
    'k': ["██╗  ██╗", "██║ ██╔╝", "█████╔╝ ", "██╔═██╗ ", "██║  ██╗", "╚═╝  ╚═╝"],
    'l': ["██╗     ", "██║     ", "██║     ", "██║     ", "███████╗", "╚══════╝"],
    'm': ["███╗   ███╗", "████╗ ████║", "██╔████╔██║", "██║╚██╔╝██║", "██║ ╚═╝ ██║", "╚═╝     ╚═╝"],
    'n': ["███╗   ██╗", "████╗  ██║", "██╔██╗ ██║", "██║╚██╗██║", "██║ ╚████║", "╚═╝  ╚═══╝"],
    'o': [" ██████╗ ", "██╔═══██╗", "██║   ██║", "██║   ██║", "╚██████╔╝", " ╚═════╝ "],
    'p': ["██████╗ ", "██╔══██╗", "██████╔╝", "██╔═══╝ ", "██║     ", "╚═╝     "],
    'q': [" ██████╗ ", "██╔═══██╗", "██║   ██║", "██║▄▄ ██║", "╚██████╔╝", " ╚══▀▀═╝ "],
    'r': ["██████╗ ", "██╔══██╗", "██████╔╝", "██╔══██╗", "██║  ██║", "╚═╝  ╚═╝"],
    's': ["███████╗", "██╔════╝", "███████╗", "╚════██║", "███████║", "╚══════╝"],
    't': ["████████╗", "╚══██╔══╝", "   ██║   ", "   ██║   ", "   ██║   ", "   ╚═╝   "],
    'u': ["██╗   ██╗", "██║   ██║", "██║   ██║", "██║   ██║", "╚██████╔╝", " ╚═════╝ "],
    'v': ["██╗   ██╗", "██║   ██║", "██║   ██║", "╚██╗ ██╔╝", " ╚████╔╝ ", "  ╚═══╝  "],
    'w': ["██╗    ██╗", "██║    ██║", "██║ █╗ ██║", "██║███╗██║", "╚███╔███╔╝", "╚══╝╚══╝ "],
    'x': ["██╗  ██╗", "╚██╗██╔╝", " ╚███╔╝ ", " ██╔██╗ ", "██╔╝ ██║", "╚═╝  ╚═╝"],
    'y': ["██╗   ██╗", "╚██╗ ██╔╝", " ╚████╔╝ ", "  ╚██╔╝  ", "   ██║   ", "   ╚═╝   "],
    'z': ["███████╗", "╚══███╔╝", "  ███╔╝ ", " ███╔╝  ", "███████╗", "╚══════╝"],
}

# ═══════════════════════════════════════════════════════════════════
#  RENDERING LOGIC WITH SUNSET GRADIENT (Hot Pink -> Deep Orange)
# ═══════════════════════════════════════════════════════════════════
def main():
    # Get lowercase hostname
    hostname = platform.node().lower()

    # Filter only a-z characters (skip digits, hyphens, etc.)
    chars = [ch for ch in hostname if ch in FONT]
    count = len(chars)

    if count == 0:
        return

    # Sunset Gradient Endpoints (RGB)
    # Start: Hot Pink (#FF69B4)
    start_r, start_g, start_b = 255, 105, 180
    # End: Deep Orange (#FF3D00)
    end_r, end_g, end_b = 255, 61, 0

    # Pre-calculate colors and glyph strings for each letter position
    letter_data = []
    divisor = max(count - 1, 1)

    for i, ch in enumerate(chars):
        # Linear Interpolation (Scale: 0 to 1, then map to 0-255)
        ratio = i / divisor
        
        r = int(start_r + (end_r - start_r) * ratio)
        g = int(start_g + (end_g - start_g) * ratio)
        b = int(start_b + (end_b - start_b) * ratio)

        # TrueColor ANSI escape code: \033[38;2;R;G;Bm
        color_code = f"\033[38;2;{r};{g};{b}m"
        
        # Store the 6 rows of this character, each prefixed with its specific color
        letter_data.append([{
            "glyph": FONT[ch][row],
            "color": color_code
        } for row in range(FONT_ROWS)])

    # Assemble and print lines
    padding = "      "  # 6 spaces gap between letters
    
    for row in range(FONT_ROWS):
        line_parts = []
        for letter_info_list in letter_data:
            info = letter_info_list[row]
            line_parts.append(f"{info['color']}{info['glyph']}{padding}")
        
        print("".join(line_parts))

if __name__ == "__main__":
    main()
