#!/usr/bin/env python3
from __future__ import annotations

import json
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass

ESPN_STANDINGS = "https://site.web.api.espn.com/apis/v2/sports/soccer"
USER_AGENT = "Mozilla/5.0 (X11; Linux x86_64)"


@dataclass
class League:
    id: str
    label: str
    color: str


@dataclass
class Row:
    rank: int
    team: str
    games_played: int
    wins: int
    draws: int
    losses: int
    goals_for: int
    goals_against: int
    goal_diff: int
    points: int


@dataclass
class LeagueTable:
    season: str
    rows: list[Row]


class TermColor:
     BLACK = '\033[30m'
     RED = '\033[31m'
     GREEN = '\033[32m'
     YELLOW = '\033[33m' # orange on some systems
     BLUE = '\033[34m'
     MAGENTA = '\033[35m'
     CYAN = '\033[36m'
     LIGHT_GRAY = '\033[37m'
     DARK_GRAY = '\033[90m'
     BRIGHT_RED = '\033[91m'
     BRIGHT_GREEN = '\033[92m'
     BRIGHT_YELLOW = '\033[93m'
     BRIGHT_BLUE = '\033[94m'
     BRIGHT_MAGENTA = '\033[95m'
     BRIGHT_CYAN = '\033[96m'
     WHITE = '\033[97m'

     RESET = '\033[0m'


LEAGUES = [
    League("eng.1", "Premier League", TermColor.BRIGHT_MAGENTA),
    League("eng.2", "Championship", TermColor.CYAN),
    League("eng.3", "League One", TermColor.GREEN),
    League("ita.1", "Serie A", TermColor.BLUE),
    League("ger.1", "Bundesliga", TermColor.BRIGHT_RED),
]


def fetch_json(url: str) -> dict:
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(request, timeout=20) as response:
        return json.load(response)


def stat_value(entry: dict, abbreviation: str) -> int:
    for stat in entry["stats"]:
        if stat["abbreviation"] == abbreviation:
            return int(stat["value"] or 0)
    return 0


def to_row(entry: dict) -> Row:
    return Row(
        rank=stat_value(entry, "R"),
        team=entry["team"]["displayName"],
        games_played=stat_value(entry, "GP"),
        wins=stat_value(entry, "W"),
        draws=stat_value(entry, "D"),
        losses=stat_value(entry, "L"),
        goals_for=stat_value(entry, "F"),
        goals_against=stat_value(entry, "A"),
        goal_diff=stat_value(entry, "GD"),
        points=stat_value(entry, "P"),
    )


def fetch_table(league: League) -> LeagueTable:
    url = f"{ESPN_STANDINGS}/{league.id}/standings?region=us&lang=en&contentorigin=espn"
    data = fetch_json(url)
    child = data["children"][0]
    entries = child["standings"]["entries"]
    rows = [to_row(entry) for entry in entries]
    rows.sort(key=lambda row: (row.rank == 0, row.rank, -row.points))
    return LeagueTable(season=child["name"], rows=rows)


def format_table(table: LeagueTable) -> str:
    width = max(len(row.team) for row in table.rows)
    lines = [f"{table.season}"]
    lines.append(
        "  " + f"{'Team':<{width}}  {'GP':>2} {'W':>2} {'D':>2} {'L':>2} "
        f"{'GF':>2} {'GA':>2} {'GD':>3} {'Pts':>3}"
    )
    for row in table.rows:
        lines.append(
            f"  {row.team:<{width}}  {row.games_played:>2} {row.wins:>2} {row.draws:>2} "
            f"{row.losses:>2} {row.goals_for:>2} {row.goals_against:>2} "
            f"{row.goal_diff:>3} {row.points:>3}"
        )
    return "\n".join(lines)


def main() -> None:
    with ThreadPoolExecutor(max_workers=len(LEAGUES)) as pool:
        futures = [pool.submit(fetch_table, league) for league in LEAGUES]
        for league, future in zip(LEAGUES, futures):
            header = league.color + league.label + TermColor.RESET
            print(f"{header}")
            print(format_table(future.result()))
            print()


if __name__ == "__main__":
    main()
